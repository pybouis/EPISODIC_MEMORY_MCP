# Configuration du serveur episodic-memory-mcp.exe : copier en « .env » à côté de l'exe.
# Les variables d'environnement Windows priment sur ce fichier.

# ----------------------------------------------------------------- serveur
EPISODIC_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8010
# URL publique du tunnel (sans /mcp) : son hôte est accepté dans l'en-tête Host.
MCP_PUBLIC_BASE_URL=https://xxxxxxxx-8010.euw.devtunnels.ms

# ----------------------------------------------------------------- données (hors OneDrive)
EPISODIC_DATA_DIR=C:\episodic_memory_mcp\data
# Modèle d'embedding livré avec l'exe (build_exe.ps1 -WithModel) : décommenter si le
# serveur n'a pas accès à Hugging Face.
# EPISODIC_MODEL_CACHE=C:\episodic_memory_mcp\episodic-memory-mcp\models
# EPISODIC_EXPORT_DIR=C:\episodic_memory_mcp\exports

# ----------------------------------------------------------------- sécurité
# local : utilisateurs, groupes et jetons gérés dans la base (episodic-memory-mcp.exe user …)
# pa    : identité et groupes lus dans Planning Analytics avec le jeton OAuth de l'appelant
EPISODIC_AUTH_PROVIDER=local
# Groupe des épisodes stockés par un administrateur sans groupe précisé.
EPISODIC_DEFAULT_GROUP=ADMIN

# ----------------------------------------------------------------- variante Planning Analytics
# Racine REST de la base TM1 qui porte les groupes :
# EPISODIC_PA_URL=https://eu-central-1.planninganalytics.saas.ibm.com/api/<tenant>/v0/tm1/<base>
# Groupes PA reconnus : EPISODIC_<GROUPE> (membre), EPISODIC_<GROUPE>_ADMIN (admin du groupe).
# Préfixe vide = tous les groupes PA deviennent des groupes de la mémoire.
# EPISODIC_PA_GROUP_PREFIX=EPISODIC_
# EPISODIC_PA_GROUP_ADMIN_SUFFIX=_ADMIN
# Groupes PA dont les membres administrent toute la mémoire (séparés par des virgules).
# EPISODIC_PA_ADMIN_GROUPS=EPISODIC_ADMIN
# Durée de mise en cache des groupes d'un jeton, en secondes.
# EPISODIC_PA_CACHE_SECONDS=300
# Validité des liens d'envoi et de téléchargement des fichiers produits, en minutes.
# EPISODIC_FILE_LINK_MINUTES=30
# Taille maximale d'un fichier produit, en Mo.
# EPISODIC_ARTIFACT_MAX_MB=50

# ----------------------------------------------------------------- recherche hybride (vecteur + mots-clés)
# Similarité minimale pour proposer une question.
# EPISODIC_THRESHOLD=0.75
# Bonus quand un mot-clé de l'épisode figure dans la question (0 = recherche purement vectorielle),
# accordé si la similarité vectorielle atteint le plancher.
# EPISODIC_KEYWORD_BONUS=0.25
# EPISODIC_KEYWORD_FLOOR=0.45
# Part des mots de la question retrouvés dans l'épisode à partir de laquelle un mot-clé suffit seul.
# EPISODIC_KEYWORD_COVERAGE=0.75
# Glossaire de synonymes (défaut : <EPISODIC_DATA_DIR>\glossary.json).
# EPISODIC_GLOSSARY=C:\episodic_memory_mcp\data\glossary.json
